# Salin file ini menjadi ".env" (di dalam folder server/), lalu isi nilainya.
# JANGAN commit file .env. Hanya .env.example yang boleh masuk GitHub.

# API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_kamu_di_sini

# Nama model. Jika muncul error "model not found", salin nama model
# terbaru dari Google AI Studio atau dokumentasi Gemini API.
GEMINI_MODEL=gemini-3.7-flash

# Tingkat "berpikir" model: minimal / low / medium / high.
# Kosongkan nilainya jika model kamu menolak parameter ini.
GEMINI_REASONING_EFFORT=low

# Port backend lokal
PORT=3001
